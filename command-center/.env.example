# ─────────────────────────────────────────────────────────────────────────────
# The Investor's Command Center — environment
# Copy to .env.local for local dev, or set these in Vercel.
# The app RUNS WITH NONE OF THESE (demo mode: sample data, canned AI). Add them to
# unlock real auth, your private data, and live Claude.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI (Anthropic Claude) ────────────────────────────────────────────────────
# Without this, mentors/agents use the rule-based fallback.
ANTHROPIC_API_KEY=
# Optional: route through a gateway/proxy instead of api.anthropic.com
# ANTHROPIC_BASE_URL=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Without these, the app runs in demo mode (no sign-in).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Without these, holdings/goals come from the bundled sample data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Market data (optional) ───────────────────────────────────────────────────
# Free tier from finnhub.io or alphavantage.co. Falls back to static snapshot.
MARKET_DATA_API_KEY=
